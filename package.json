{
  "name": "product-intelligence-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "test:browser": "node --env-file-if-exists=.env --test tests/browser.e2e.ts",
    "test": "node --check web/app.js && node --check web/view.js && node --env-file-if-exists=.env --test tests/*.test.ts",
    "benchmark": "node scripts/benchmark.ts",
    "privacy": "node scripts/privacy-check.ts",
    "cli": "node --env-file-if-exists=.env src/cli.ts",
    "start": "node --env-file-if-exists=.env src/app.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  }
}
